# ---------------------------------------------------------------------------
# Production environment template.
#
#   cp .env.production.example .env
#
# then replace every "change-me". This file must never hold real secrets — it is
# committed to the repository. The live `.env` is ignored by git and by
# .dockerignore, so nothing here ends up inside the app image.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# The hostname users will visit. Caddy obtains a TLS certificate for it
# automatically, so its DNS record must already point at this server and ports
# 80/443 must be reachable.
# ---------------------------------------------------------------------------
APP_DOMAIN="mkpl.co.in"

# ---------------------------------------------------------------------------
# PostgreSQL. The app's DATABASE_URL is built from POSTGRES_PASSWORD by
# docker-compose.yml, so the two cannot drift apart.
#
# Generate a password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# The DATABASE_URL line below is only for running the CLI from the host.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD="Qwerty123"
DATABASE_URL="postgresql://postgres:Qwerty123@127.0.0.1:5432/stock_market_app"

# ---------------------------------------------------------------------------
# Signs session cookies. Anyone holding this can forge a login, so it must be
# unique to this deployment.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="KfxjAgiBbL7WXbU7RTdX7jxe4PVlamu8B7G5MCZPvgHhFGPERmPpKFIUg7D8KDa"

# ---------------------------------------------------------------------------
# Caddy serves the site over HTTPS, so this must stay "true".
# ---------------------------------------------------------------------------
AUTH_COOKIE_SECURE="true"

# ---------------------------------------------------------------------------
# Administrator access.
#
# There is NO default admin account and NO default password. After the first
# deploy, go to /signin, choose "Sign up", and register the address below with a
# password of your choosing — the admin role is granted at sign-up.
#
# Do that before sharing the URL: sign-up does not verify email addresses, so
# until the account exists anyone could register this address and become an
# administrator.
# ---------------------------------------------------------------------------
ADMIN_EMAILS="admin@mkpl.co.in"

# ---------------------------------------------------------------------------
# Password reset email, delivered through Resend.
#
# Use a send-only API key here, not one with full account access.
# ---------------------------------------------------------------------------
AUTH_MAIL_TRANSPORT="resend"
RESEND_API_KEY="re_SXoevHnt_JNHCYzibuyviKrBizg62wJwB"
AUTH_MAIL_FROM="MarketLearn <admin@mkpl.co.in>"

# ---------------------------------------------------------------------------
# Abuse protection for sign-in, sign-up and password resets. Leave it on.
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT_ENABLED="true"
