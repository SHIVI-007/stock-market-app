# ---------------------------------------------------------------------------
# PostgreSQL connection string.
#
# Used in two places:
#   1. The Prisma CLI (migrations, `prisma migrate deploy`, `prisma db seed`),
#      read via `prisma.config.ts`.
#   2. The application runtime, where Prisma 7 connects through the
#      `@prisma/adapter-pg` driver adapter.
#
# Copy this file to `.env` and adjust the credentials.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_market_app"

# ---------------------------------------------------------------------------
# Password for the PostgreSQL container in docker-compose.yml.
#
# The app's DATABASE_URL is built from this, so the two cannot drift apart. It is
# read from this file by Compose, and is never baked into the app image.
#
# Changing it on a volume that already exists does NOT change the password the
# database is actually using — either start from a fresh volume, or run
# `ALTER USER postgres WITH PASSWORD '...'` inside the container.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD="postgres"

# ---------------------------------------------------------------------------
# Secret used to sign session cookies (email sign-in).
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Sessions fail over to an insecure development value when this is unset.
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Set to "true" only when the app is served over HTTPS.
#
# Compose requires this to be set explicitly, so it cannot be forgotten during a
# deployment. When false the session cookie is still httpOnly and SameSite=Lax,
# which keeps local production testing over http:// working — but a deployment
# answering on https:// must use "true", or the session cookie would also be
# sent over plain HTTP.
# ---------------------------------------------------------------------------
AUTH_COOKIE_SECURE="false"

# ---------------------------------------------------------------------------
# Abuse protection for sign-in, sign-up and password resets.
#
# On by default. Counters live in the app process, which is what a single
# container needs; running more than one replica would need a shared store.
# Set to "false" only to disable it deliberately.
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT_ENABLED="true"

# ---------------------------------------------------------------------------
# Password reset emails.
#
# "console" (the default) writes the reset link to the server log instead of
# sending an email. Because nothing is delivered, the UI also shows the link
# directly — but never in production, where a hard guard disables it.
#
# "resend" delivers through https://resend.com. It requires RESEND_API_KEY, and
# AUTH_MAIL_FROM should name a sender on a domain verified in that account —
# otherwise Resend only accepts mail to your own account address.
# ---------------------------------------------------------------------------
AUTH_MAIL_TRANSPORT="console"
AUTH_DEV_SHOW_RESET_LINK="true"

# Only read when AUTH_MAIL_TRANSPORT="resend". Keep the value out of git.
RESEND_API_KEY=""

# The From header, e.g. "MarketLearn <no-reply@your-domain.com>".
# Defaults to Resend's shared onboarding address when unset.
AUTH_MAIL_FROM="MarketLearn <admin@your-domain.com>"

# --------------------------------------------------------------------------
# Administrator access.
#
# Any account whose email is listed here is granted the admin role at sign-up
# and at sign-in — the way to bootstrap your very first administrator. Separate
# several addresses with commas. The password is still required, so listing an
# address does not by itself grant access.
#
# Signing up does not verify the address, so claim a listed mailbox promptly:
# until it exists, anyone could register it and be made an administrator.
#
# Once you have one admin you can promote others from /admin, so this list can
# be emptied afterwards.
# --------------------------------------------------------------------------
ADMIN_EMAILS="admin@your-domain.com"

# ---------------------------------------------------------------------------
# Absolute base URL used to build links in emails. Optional: when unset the app
# derives it from the incoming request headers.
#
# Set this in production so reset links point at your real domain no matter what
# a proxy forwards.
# ---------------------------------------------------------------------------
# APP_URL="http://localhost:3000"
